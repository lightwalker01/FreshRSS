<?php
	declare(strict_types=1);
	/** @var FreshRSS_View $this */
	if ($this->ext_details === null) {
		throw new FreshRSS_Context_Exception('Extension not initialised!');
	}

	$name_encoded = urlencode($this->ext_details->getName());
	$ext_enabled = $this->ext_details->isEnabled();
	if ($ext_enabled) {
		$button_class = ' active';
		$name_class = '';
		$action = 'disable';
		$title = _t('gen.action.disable');
	} else {
		$button_class = '';
		$name_class = ' disabled';
		$action = 'enable';
		$title = _t('gen.action.enable');
	}
	if ($this->ext_details->getType() === 'user' || FreshRSS_Auth::hasAccess('admin')) {?>
	<button class="switch<?= $button_class ?>" formaction="<?= _url('extension', $action, 'e', $name_encoded) ?>" title="<?= $title ?>" aria-label="<?= $title ?>"></button>
	<a class="open-slider configure" title="<?= _t('gen.action.manage') ?>" href="<?= _url('extension', 'configure', 'e', $name_encoded) ?>"><?= _i('configure') ?></a>
	<span class="ext_name<?= $name_class ?>"><?= htmlspecialchars($this->ext_details->getName(), ENT_QUOTES, 'UTF-8') ?></span>
<?php } else { ?>
	<button class="switch<?= $button_class ?>" title="<?= _t('admin.extensions.system.no_rights') ?>" disabled="disabled"></button>
	<span class="ext_name<?= $name_class ?>"><?= htmlspecialchars($this->ext_details->getName(), ENT_QUOTES, 'UTF-8') ?></span>
<?php } ?>
<span>(<?= htmlspecialchars($this->ext_details->getVersion(), ENT_QUOTES, 'UTF-8') ?>)</span>
<?php if (FreshRSS_Auth::hasAccess('admin') && dirname($this->ext_details->getPath()) === THIRDPARTY_EXTENSIONS_PATH) { ?>
	<?php if (FreshRSS_ExtensionMarketplace::canRemove($this->ext_details)) { ?>
		<button class="btn btn-attention confirm" disabled formaction="<?= _url('extension', 'remove', 'e', $name_encoded) ?>"
			data-str-confirm="<?= _t('admin.extensions.marketplace.confirm_remove') ?>"><?= _t('admin.extensions.marketplace.uninstall') ?></button>
	<?php } else { ?>
		<span><?= _t('admin.extensions.marketplace.cannot_remove') ?></span>
	<?php } ?>
<?php } ?>
