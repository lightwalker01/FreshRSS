<?php
	declare(strict_types=1);
	/** @var FreshRSS_View $this */
	$this->partial('aside_configure');
?>
<main class="post">
	<h1><?= _t('admin.extensions.title') ?></h1>
	<form method="post">
	<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
	<?php if (!empty($this->extension_list['system'])) { ?>
	<h2><?= _t('admin.extensions.system') ?></h2>
	<ul class="manage-list">
	<?php
		foreach ($this->extension_list['system'] as $ext) {
			$this->ext_details = $ext; ?>
			<li>
			<?php $this->renderHelper('extension/details'); ?>
			</li>
		<?php } ?>
	</ul>
	<?php } ?>

	<?php if (!empty($this->extension_list['user'])) { ?>
	<h2><?= _t('admin.extensions.user') ?></h2>
	<ul class="manage-list">
	<?php
		foreach ($this->extension_list['user'] as $ext) {
			$this->ext_details = $ext; ?>
			<li>
			<?php $this->renderHelper('extension/details'); ?>
			</li>
		<?php } ?>
		</ul>
	<?php }

	if (Minz_ExtensionManager::listExtensions() === []) {
	?>
	<p class="alert alert-warn"><?= _t('admin.extensions.empty_list') ?></p>
	<?php } ?>
	</form>

	<?php if ($this->catalog_enabled) { ?>
		<form method="post" action="<?= _url('extension', 'refresh') ?>">
			<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
			<button class="btn"><?= _t('admin.extensions.marketplace.refresh') ?></button>
		</form>
	<?php } else { ?>
		<p><?= _t('admin.extensions.marketplace.privacy') ?></p>
	<?php } ?>

	<?php foreach ($this->marketplace as $group => $rows) { ?>
		<h2><?= _t('admin.extensions.marketplace.' . $group) ?></h2>
		<?php if ($rows === []) { ?>
			<p><?= _t('admin.extensions.empty_list_help') ?></p>
			<?php continue;
		} ?>
		<div class="table-wrapper scrollbar-thin">
			<table>
				<tr>
					<th><?= _t('admin.extensions.name') ?></th>
					<th><?= _t('admin.extensions.version') ?></th>
					<th><?= _t('admin.extensions.author') ?></th>
					<th><?= _t('admin.extensions.description') ?></th>
					<th><?= _t('gen.action.manage') ?></th>
				</tr>
				<?php foreach ($rows as $row) {
					$entry = $row['entry'];
					$status = $row['status'];
					$encode = static fn (string $text): string => htmlspecialchars($text, ENT_QUOTES, 'UTF-8');
					$newer = $status['version'] !== '' && version_compare($status['version'], $entry['version'], '<');
					$this->ext_details = $row['local'];
					?>
					<tr>
						<td><a href="<?= $encode($entry['url']) ?>" target="_blank" rel="noopener noreferrer"><?= $encode($entry['name']) ?></a></td>
						<td>
							<?= $encode($status['version'] ?: $entry['version']) ?>
							<?php if ($newer) { ?>
								<br /><?= _t('admin.extensions.marketplace.new_version', $encode($entry['version'])) ?>
							<?php } ?>
						</td>
						<td><?= $encode($entry['author']) ?></td>
						<td><?= $encode($entry['description']) ?></td>
						<td>
							<?php if ($row['local'] !== null) { ?>
								<form method="post">
									<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
									<?php $this->renderHelper('extension/details'); ?>
								</form>
							<?php } ?>
							<?php if ($status['reason'] !== '') { ?>
								<p><?= _t('admin.extensions.marketplace.' . $status['reason']) ?></p>
							<?php } elseif ($status['action'] !== '' && FreshRSS_Auth::hasAccess('admin')) { ?>
								<form method="post" action="<?= _url('extension', 'marketplace') ?>">
									<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
									<input type="hidden" name="id" value="<?= FreshRSS_ExtensionCatalog::id($entry) ?>" />
									<input type="hidden" name="operation" value="<?= $status['action'] ?>" />
									<?php if ($group === 'community') { ?>
										<p><?= $encode($entry['url']) ?></p>
										<button class="btn confirm" disabled
											data-str-confirm="<?= $encode(_t('admin.extensions.marketplace.confirm_source', $entry['url'])) ?>">
											<?= _t('admin.extensions.marketplace.' . $status['action']) ?>
										</button>
									<?php } else { ?>
										<button class="btn"><?= _t('admin.extensions.marketplace.' . $status['action']) ?></button>
									<?php } ?>
								</form>
							<?php } ?>
						</td>
					</tr>
				<?php } ?>
			</table>
		</div>
	<?php } ?>
</main>

<?php $class = isset($this->extension) ? ' active' : ''; ?>
<?php $closelink = isset($this->extension) ? _url('extension', 'index') : ''; ?>
<aside id="slider">
<a class="toggle_aside" href="<?= $closelink ?>#close"><?= _i('close') ?></a>
	<div id="slider-content">
		<?php
			if (isset($this->extension)) {
				$this->renderHelper('extension/configure');
			}
		?>
	</div>
</aside>
<a href="#close" id="close-slider">
	<?= _i('close') ?>
</a>
<script src="../scripts/config.js?<?= @filemtime(PUBLIC_PATH . '/scripts/config.js') ?>"></script>
